# Rust Book Self-Hosted Configuration

# Server Settings
PORT=3000
DB_PATH=/app/data/rust-book.db
BOOK_PATH=/app/public
NODE_ENV=production

# SSO Configuration (OpenID Connect)
# Set SSO_ENABLED=true to enable authentication
SSO_ENABLED=false

# OIDC Provider Settings (required when SSO_ENABLED=true)
# Examples for different providers:

# SSO_BASE_URL=https://your-authentik.com/application/o/
SSO_BASE_URL=
# SSO_APPLICATION_SLUG=rust-book
SSO_APPLICATION_SLUG=

# sso issuer URL will be constructed as: ${SSO_BASE_URL}${SSO_APPLICATION_SLUG}/
# sso authorize url will be constructed as: ${SSO_BASE_URL}authorize/
# sso token url will be constructed as: ${SSO_BASE_URL}token/
# sso userinfo url will be constructed as: ${SSO_BASE_URL}userinfo/

SSO_CLIENT_ID=
SSO_CLIENT_SECRET=
SSO_CALLBACK_URL=https://your-domain.com/auth/callback

# Session Configuration
# Generate a secure random string: openssl rand -base64 32
SESSION_SECRET=
