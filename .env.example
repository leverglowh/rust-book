# Rust Book Self-Hosted Configuration

# Server Settings
PORT=3000
DB_PATH=/app/data/rust-book.db
BOOK_PATH=/app/public
NODE_ENV=production

# SSO Configuration (OpenID Connect)
# Set SSO_ENABLED=true to enable authentication
SSO_ENABLED=false

# OIDC Provider Settings (required when SSO_ENABLED=true)
# Examples for different providers:

# Authentik:
# SSO_ISSUER=https://your-authentik.com/application/o/rust-book/

# Keycloak:
# SSO_ISSUER=https://your-keycloak.com/realms/your-realm

# Auth0:
# SSO_ISSUER=https://your-tenant.auth0.com

# Azure AD:
# SSO_ISSUER=https://login.microsoftonline.com/<tenant-id>/v2.0

SSO_ISSUER=
SSO_CLIENT_ID=
SSO_CLIENT_SECRET=
SSO_CALLBACK_URL=https://your-domain.com/auth/callback

# Session Configuration
# Generate a secure random string: openssl rand -base64 32
SESSION_SECRET=
